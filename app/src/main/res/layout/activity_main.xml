<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alignmentMode="alignBounds"
    android:columnCount="12"
    android:padding="@dimen/screen_padding"
    android:useDefaultMargins="false">

    <!-- Равные колонки, чтобы строка ввода и кнопки делили ширину одинаково. -->
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="0" android:layout_columnWeight="1" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="1" android:layout_columnWeight="1" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="2" android:layout_columnWeight="1" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="3" android:layout_columnWeight="1" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="4" android:layout_columnWeight="1" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="5" android:layout_columnWeight="1" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="6" android:layout_columnWeight="1" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="7" android:layout_columnWeight="1" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="8" android:layout_columnWeight="1" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="9" android:layout_columnWeight="1" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="10" android:layout_columnWeight="1" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_row="0" android:layout_column="11" android:layout_columnWeight="1" />

    <EditText
        android:id="@+id/operand1"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_columnSpan="3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="fill_horizontal|center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:imeOptions="actionNext|flagNoExtractUi"
        android:inputType="numberSigned|numberDecimal"
        android:maxLines="1"
        android:textColor="@color/calc_text"
        android:textSize="@dimen/input_text_size" />

    <TextView
        android:id="@+id/operationText"
        android:layout_row="1"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="fill_horizontal|center_vertical"
        android:freezesText="true"
        android:gravity="center"
        android:text="@string/operation_add"
        android:textColor="@color/calc_text"
        android:textSize="@dimen/input_text_size" />

    <EditText
        android:id="@+id/operand2"
        android:layout_row="1"
        android:layout_column="4"
        android:layout_columnSpan="3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="fill_horizontal|center_vertical"
            android:gravity="center_vertical"
            android:imeOptions="actionDone|flagNoExtractUi"
        android:inputType="numberSigned|numberDecimal"
        android:maxLines="1"
        android:textColor="@color/calc_text"
        android:textSize="@dimen/input_text_size" />

    <TextView
        android:layout_row="1"
        android:layout_column="7"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="fill_horizontal|center_vertical"
        android:gravity="center"
        android:text="@string/equals_sign"
        android:textColor="@color/calc_text"
        android:textSize="@dimen/input_text_size" />

    <TextView
        android:id="@+id/resultText"
        android:layout_row="1"
        android:layout_column="8"
        android:layout_columnSpan="4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="fill_horizontal|center_vertical"
        android:ellipsize="end"
        android:freezesText="true"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/calc_text"
        android:textSize="@dimen/input_text_size" />

    <Button
        android:id="@+id/addButton"
        style="@style/CalcButton"
        android:layout_row="2"
        android:layout_column="0"
        android:layout_rowSpan="2"
        android:layout_columnSpan="4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="fill"
        android:layout_margin="4dp"
        android:text="@string/operation_add" />

    <Button
        android:id="@+id/subButton"
        style="@style/CalcButton"
        android:layout_row="2"
        android:layout_column="4"
        android:layout_columnSpan="4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="fill"
        android:layout_margin="4dp"
        android:minHeight="@dimen/op_button_min_height"
        android:text="@string/operation_sub" />

    <Button
        android:id="@+id/divButton"
        style="@style/CalcButton"
        android:layout_row="2"
        android:layout_column="8"
        android:layout_columnSpan="4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="fill"
        android:layout_margin="4dp"
        android:minHeight="@dimen/op_button_min_height"
        android:text="@string/operation_div" />

    <Button
        android:id="@+id/mulButton"
        style="@style/CalcButton"
        android:layout_row="3"
        android:layout_column="4"
        android:layout_columnSpan="8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="fill"
        android:layout_margin="4dp"
        android:minHeight="@dimen/op_button_min_height"
        android:text="@string/operation_mul" />

    <Button
        android:id="@+id/clearButton"
        style="@style/CalcButton"
        android:layout_row="4"
        android:layout_column="0"
        android:layout_columnSpan="12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="fill"
        android:layout_margin="4dp"
        android:minHeight="@dimen/op_button_min_height"
        android:text="@string/clear" />

    <TextView
        android:id="@+id/studentInfo"
        android:layout_row="5"
        android:layout_column="0"
        android:layout_columnSpan="12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="fill_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/student_info"
        android:textColor="@color/student_text"
        android:textSize="@dimen/student_text_size" />

</GridLayout>
